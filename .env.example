# Shared bot configuration
# Optional percentage adjustment applied to retail gold & silver estimates (-25 to 25)
PRICE_OFFSET_PERCENT=0
# Set to true to preview formatted messages without sending
DRY_RUN=true

# WhatsApp Channel bot (bot/price-channel.mjs via Whapi)
WHAPI_TOKEN=
WHAPI_CHANNEL_ID=

# Individual WhatsApp template bot (bot/individual-prices.mjs via Meta Cloud API)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_TEMPLATE_NAME=daily_prices
META_TEMPLATE_LANGUAGE=en_US
META_GRAPH_VERSION=v26.0
# JSON array of opted-in recipient objects — see docs/individual-messages.md
META_RECIPIENTS_JSON=[]
